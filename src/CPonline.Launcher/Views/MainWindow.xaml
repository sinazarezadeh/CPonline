<Window x:Class="CPonline.Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CPonline.Launcher.Views"
        Title="CPonline - Cyberpunk 2077 Co-op Launcher"
        Height="640" Width="960">
    <TabControl Margin="8">
        <TabItem Header="Mods">
            <views:ModManagerView DataContext="{Binding ModManager}" />
        </TabItem>
        <TabItem Header="Host">
            <views:HostSessionView DataContext="{Binding HostSession}" />
        </TabItem>
        <TabItem Header="Join">
            <views:JoinSessionView DataContext="{Binding JoinSession}" />
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>
</Window>
