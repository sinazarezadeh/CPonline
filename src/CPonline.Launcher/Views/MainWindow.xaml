<Window x:Class="CPonline.Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CPonline.Launcher.Views"
        Title="CPonline - Cyberpunk 2077 Co-op Launcher"
        Height="680" Width="1000" MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}"
                BorderBrush="{StaticResource AccentYellowBrush}" BorderThickness="0,0,0,2"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CP" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" FontSize="22"
                           Foreground="{StaticResource AccentYellowBrush}" />
                <TextBlock Text="ONLINE" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold" FontSize="22"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />
                <TextBlock Text="CYBERPUNK 2077 CO-OP LAUNCHER" FontFamily="{StaticResource HeaderFont}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8" Background="{StaticResource BgBrush}" BorderThickness="0">
            <TabItem Header="PLAY">
                <views:PlayView DataContext="{Binding Play}" />
            </TabItem>
            <TabItem Header="MODS">
                <views:ModManagerView DataContext="{Binding ModManager}" />
            </TabItem>
            <TabItem Header="HOST">
                <views:HostSessionView DataContext="{Binding HostSession}" />
            </TabItem>
            <TabItem Header="JOIN">
                <views:JoinSessionView DataContext="{Binding JoinSession}" />
            </TabItem>
            <TabItem Header="SETTINGS">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
