<UserControl x:Class="CPonline.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <TextBlock Text="MATCHMAKING RELAY URL" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold"
                   Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,0,8" />
        <TextBox Text="{Binding RelayUrl, UpdateSourceTrigger=PropertyChanged}" Width="360" Margin="0,0,0,24" />

        <TextBlock Text="LOCAL UDP PORT (CYBERPUNKMP)" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold"
                   Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,0,8" />
        <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" Width="100" />
    </StackPanel>
</UserControl>
