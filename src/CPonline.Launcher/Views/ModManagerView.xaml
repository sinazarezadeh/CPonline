<UserControl x:Class="CPonline.Launcher.Views.ModManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Game folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding GameRoot, Mode=OneWay}" IsReadOnly="True" Width="480" VerticalAlignment="Center" />
            <Button Content="Detect" Command="{Binding DetectGameCommand}" Margin="8,0,0,0" Padding="8,2" />
            <Button Content="Browse..." Click="BrowseButton_Click" Margin="8,0,0,0" Padding="8,2" />
        </StackPanel>

        <Button Grid.Row="1" Content="Install / Update All" Command="{Binding InstallAllCommand}"
                HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8" />

        <ListView Grid.Row="2" ItemsSource="{Binding Mods}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Mod" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Pinned Version" Width="140" DisplayMemberBinding="{Binding Tag}" />
                    <GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Install"
                                        Command="{Binding DataContext.InstallModCommand, ElementName=RootControl}"
                                        CommandParameter="{Binding}" Padding="8,2" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
