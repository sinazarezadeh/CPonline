<UserControl x:Class="CPonline.Launcher.Views.ModManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="GAME FOLDER" FontFamily="{StaticResource HeaderFont}" FontWeight="Bold"
                       Foreground="{StaticResource AccentYellowBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding GameRoot, Mode=OneWay}" IsReadOnly="True" Width="480" VerticalAlignment="Center" />
            <Button Content="DETECT" Command="{Binding DetectGameCommand}" Margin="8,0,0,0" Padding="12,4" />
            <Button Content="BROWSE..." Click="BrowseButton_Click" Margin="8,0,0,0" Padding="12,4" />
        </StackPanel>

        <Button Grid.Row="1" Content="INSTALL / UPDATE ALL" Command="{Binding InstallAllCommand}"
                HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,10" />

        <StackPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding IsInstallingAll, Converter={StaticResource BoolToVis}}">
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding OverallProgressPercent, Mode=OneWay}" />
            <TextBlock Text="{Binding OverallProgressPercent, StringFormat='Overall: {0:0}%'}" FontSize="10" Margin="0,2,0,0" />
        </StackPanel>

        <ListView Grid.Row="3" ItemsSource="{Binding Mods}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Mod" Width="220" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Pinned Version" Width="140" DisplayMemberBinding="{Binding Tag}" />
                    <GridViewColumn Header="Status" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="StatusText" Text="{Binding State}" VerticalAlignment="Center" />
                                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Width="160"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter TargetName="StatusText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="ProgressPanel" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="INSTALL"
                                        Command="{Binding DataContext.InstallModCommand, ElementName=RootControl}"
                                        CommandParameter="{Binding}" Padding="10,3" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</UserControl>
